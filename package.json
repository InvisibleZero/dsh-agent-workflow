{
  "name": "dsh-agent-workflow",
  "version": "0.2.0",
  "description": "侧栏工作区 + 树形子节点 + 五态状态机：每个子节点即一个 DSH 会话，当前状态自动决定注入给模型的操作细节，并给每个节点维护 AI 自留的工作手册与手册摘要",
  "type": "module",
  "main": "dist/host.js",
  "types": "dist/index.d.ts",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InvisibleZero/dsh-agent-workflow.git"
  },
  "homepage": "https://github.com/InvisibleZero/dsh-agent-workflow#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "workflow",
    "state-machine",
    "agent-orchestration"
  ],
  "exports": {
    ".": "./dist/host.js",
    "./client": "./dist/client-bundle.js",
    "./lib": "./dist/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "assets",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "DEVELOPMENT.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-host.mjs && tsc -p tsconfig.client-cjs.json && node scripts/bundle-client.mjs",
    "build:host": "tsc -p tsconfig.json && node scripts/build-host.mjs",
    "build:client": "tsc -p tsconfig.client-cjs.json && node scripts/bundle-client.mjs",
    "smoke": "node scripts/smoke-client.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.24.2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-modules"
      ]
    },
    "manifestVersion": 1
  }
}
